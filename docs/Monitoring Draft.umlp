import java.time.LocalDateTime;
import java.util.List;

umlp Monitoring{

    class MQTTRecord {
        String TopicString;
        LocalDateTime payloadTimestamp;
        String payloadValue
        int duplicateDelivery;
        boolean retainContent;
        LocalDateTime epoch;
        double latency;
    }

    class MQTTFetcher {
      List<MQTTRecord> getLastMQTTRecord();
    }

    enum Status{
        RUNNING,
        SUCCESS,
        FAILURE,
        PENDING;
    }

    class MonitoringLog{
        String runId;
        int invoker;
        LocalDateTime startTimestamp;
        LocalDateTime endTimestamp;

    }

    class MonitoringAction{
        String destinationIp;
        Status executionStatus = Status.PENDING;
        List<MQTTRecord> currentRecords;             // String noch mit MQTTRecorder ersetzen
    }

    association [1] MonitoringLog <-> MonitoringAction [1];
    
}
