#!/usr/bin/env bash
# ============================================================================
# mg-cli — MontiGem development CLI
# ============================================================================
# Usage:
#   ./mg-cli build fe            Build the frontend
#   ./mg-cli build be            Build the backend
#   ./mg-cli run fe [--hot]      Run the frontend (optionally with hot reload)
#   ./mg-cli run be [--hot]      Run the backend (optionally with hot reload)
#   ./mg-cli mgen fe-gui         Generate frontend GUI models (gui2java2ts)
#   ./mg-cli mgen fe-java        Generate frontend Java/TS (sync_gui2java2ts)
#   ./mg-cli mgen fe             Full frontend model generation (gui + java)
#   ./mg-cli mgen be             Generate backend from UMLP models (umlp2java)
#   ./mg-cli help                Show this help message
# ============================================================================

set -euo pipefail

# Work in the caller's current directory (so the script can live in e.g. ~/.local/bin)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

info()  { echo -e "${CYAN}[mg-cli]${NC} $*"; }
ok()    { echo -e "${GREEN}[mg-cli]${NC} $*"; }
warn()  { echo -e "${YELLOW}[mg-cli]${NC} $*"; }
err()   { echo -e "${RED}[mg-cli]${NC} $*" >&2; }

usage() {
  cat <<'EOF'
MontiGem CLI — simplified development commands

Usage: ./mg-cli <command> <target> [options]

Commands:
  build fe              Build the frontend (buildApp)
  build be              Build the backend

  run fe [--hot]        Run the frontend Angular dev server
                        --hot  also starts continuous rebuild in background
  run be [--hot]        Run the backend Spring Boot server
                        --hot  also starts continuous rebuild in background

  mgen fe-gui           Generate GUI models → Java (gui2java2ts)
  mgen fe-java          Sync GUI → Java → TypeScript (sync_gui2java2ts)
  mgen fe               Full frontend generation (gui + java + ts)
  mgen be               Generate backend from UMLP models (umlp2java)

  help                  Show this help message

Hot Reload Notes:
  When using --hot, two Gradle processes are started:
    1. The main :run task (serves the app)
    2. A :continuous --continuous task (watches for file changes)
  Both run in the foreground of the current terminal. Press Ctrl+C to stop.

  Known Limitations:
    - Changes to the DB schema (.umlp files) may require a full restart.
    - Changes to build.gradle do not trigger automatic reload.
    - During frontend reload, a brief error message may appear in the browser.
    - (Optional) Install a LiveReload browser extension for auto-refresh:
      Firefox: https://addons.mozilla.org/en-US/firefox/addon/livereload-web-extension/
      Chrome:  https://chrome.google.com/webstore/detail/livereload/jnihajbhpnppcggbcgedagnkighmdlei
EOF
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_build() {
  local target="${1:-}"
  case "$target" in
    fe)
      info "Building frontend..."
      gradle :frontend:buildApp
      ok "Frontend build complete."
      ;;
    be)
      info "Building backend..."
      gradle :backend:build
      ok "Backend build complete."
      ;;
    *)
      err "Unknown build target: '$target'"
      err "Usage: ./mg-cli build <fe|be>"
      exit 1
      ;;
  esac
}

cmd_run() {
  local target="${1:-}"
  local hot="${2:-}"

  case "$target" in
    fe)
      if [[ "$hot" == "--hot" ]]; then
        info "Starting frontend with hot reload..."
        info "Starting continuous rebuild in background..."
        gradle :frontend:continuous --continuous &
        CONTINUOUS_PID=$!
        trap "kill $CONTINUOUS_PID 2>/dev/null; exit" INT TERM
        info "Starting frontend dev server..."
        gradle :frontend:run
      else
        info "Starting frontend dev server..."
        gradle :frontend:run
      fi
      ;;
    be)
      if [[ "$hot" == "--hot" ]]; then
        info "Starting backend with hot reload..."
        info "Starting continuous rebuild in background..."
        gradle :backend:continuous --continuous &
        CONTINUOUS_PID=$!
        trap "kill $CONTINUOUS_PID 2>/dev/null; exit" INT TERM
        info "Starting backend Spring Boot server..."
        gradle :backend:run
      else
        info "Starting backend Spring Boot server..."
        gradle :backend:run
      fi
      ;;
    *)
      err "Unknown run target: '$target'"
      err "Usage: ./mg-cli run <fe|be> [--hot]"
      exit 1
      ;;
  esac
}

cmd_mgen() {
  local target="${1:-}"
  case "$target" in
    fe-gui)
      info "Generating frontend GUI models (gui2java2ts)..."
      gradle :frontend:gui2java2ts
      ok "Frontend GUI generation complete."
      ;;
    fe-java)
      info "Syncing frontend GUI → Java → TypeScript (sync_gui2java2ts)..."
      gradle :frontend:sync_gui2java2ts
      ok "Frontend sync complete."
      ;;
    fe)
      info "Running full frontend model generation..."
      gradle :frontend:gui2java2ts
      gradle :frontend:sync_gui2java2ts
      ok "Full frontend generation complete."
      ;;
    be)
      info "Generating backend from UMLP models (umlp2java)..."
      gradle :backend:umlp2java
      ok "Backend model generation complete."
      ;;
    *)
      err "Unknown mgen target: '$target'"
      err "Usage: ./mg-cli mgen <fe-gui|fe-java|fe|be>"
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  build) cmd_build "$@" ;;
  run)   cmd_run "$@" ;;
  mgen)  cmd_mgen "$@" ;;
  help|-h|--help) usage ;;
  *)
    err "Unknown command: '$COMMAND'"
    usage
    exit 1
    ;;
esac
