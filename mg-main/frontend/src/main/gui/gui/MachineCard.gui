package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import gui.navigation.NavContainer;

import Domain.Machine;
import Domain.MachineState;

page MachineCard(List<Machine> machines)
{

  @NavContainer(content = [
    @GemColumn(rowGap = "20px", width = "90%", hAlign = "center", components = [

      @GemText(value = "Monitoring Machines Overview", size = "2rem", weight = "bold"),

      @GemGrid(
        x = ["1fr", "1fr", "1fr"],
        colGap = "30px",
        rowGap = "30px",
        rows = [
          [
            @iterate(Machine m : machines) {
              machineInfo@GemCard(
                titleComponent = @GemRow(colGap = "10px", vAlign = "center", components = [
                  @GemIcon(
                    name = "precision_manufacturing",
                    size = "24px",
                    color = m.state == MachineState.RUNNING ? "#4caf50" : "#f44336"
                  ),
                  @GemText(value = m.displayName, size = "1.2rem", weight = "bold")
                ]),

                component = @GemColumn(rowGap = "15px", components = [

                  @GemImage(
                    width = "100%",
                    height = "150px",
                    source = "assets/images/" + m.name + ".png"
                  ),

                  @GemRow(colGap = "10px", hAlign = "space-between", vAlign = "center", components = [

                    @GemColumn(components = [
                      @GemText(value = "Operational Status", size = "0.8rem", color = "grey"),
                      @GemText(
                        value = m.state.toString(),
                        size = "1rem",
                        weight = "bold",
                        color = m.state == MachineState.RUNNING ? "#4caf50" : "#f44336"
                      )
                    ]),

                    //Variante 1
                    @GemButton(label = "Details Click Me!", leftClick = openDialog()),
                          dialog@GemDialog(isOpen = dialogOpen, component =
                            @GemCard(
                              title = "Machine Details",
                              titleComponent = @GemText(value = name, size = "1.4rem", weight = "bold"),
                              component = @GemRow(colGap = "30px", components = [

                               //links Bild
                               @GemImage(
                                 source = "assets/images/" + m.name + ".png"
                                 width = "320px",
                                 height = "240px",
                               ),

                               //rechts details
                               @GemColumn(rowGap = "15px", components = [

                                 @GemRow(colGap = "10px", components = [
                                   @GemText(value = "Status: "),
                                   @GemText(value = status)
                                 ]),

                                 @GemRow(colGap = "10px", components = [
                                   @GemText(value = "Temperature: "),
                                   @GemText(value = temperature.toString() + " °C")
                                 ]),

                                 @GemRow(colGap = "10px", components = [
                                   @GemText(value = "RPM: "),
                                   @GemText(value = rpm.toString())
                                 ]),

                                 @GemRow(colGap = "10px", components = [
                                   @GemLoadingSpinner(
                                      size = "10px",
                                      intermediate = true,
                                      label = "Loading ..."
                                   @GemText(value = load.toString() + " %")
                                 ]),

                                 @GemRow(colGap = "10px", components = [
                                   @GemText(value = "Last maintenance: "),
                                   @GemText(value = lastMaintenance)
                                 ]),

                                 @GemButton(
                                   label = "Close",
                                   leftClick = closePopup()
                                 )
                               ])
                             ])
                           );
                          ),

                    //Variante 2
                    @GemButton(
                      label = "Details",
                      leftClick = showDialog(MachineDetailsPopup(
                        m.displayName,
                        m.state.toString(),
                        m.temperature,
                        m.liveRpm,
                        m.load,
                        m.lastMaintenance,
                        "assets/images/" + m.name + ".png"
                      ))
                    )
                  ])
                ])
              )
            }
          ]
        ]
      )
    ])
  ])
}
