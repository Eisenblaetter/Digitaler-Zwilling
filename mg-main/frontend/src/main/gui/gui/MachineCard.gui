package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import gui.navigation.NavContainer;

import DigitalTwin.Machine;

page MachineCard(List<Machine> machines) {
  @NavContainer(content = [
    @GemColumn(rowGap = "10px", width = "100%", hAlign = "center", components = [

      @GemText(value = "Machines", weight = "bold"),
       @GemGrid(
         x = ["1fr", "1fr", "1fr"],
         colGap = "20px",
         rowGap = "20px",
         rows = [
            [
            @iterate(Machine m : machines) {
                machineInfo@GemCard(
                  titleComponent = @GemImage(width = "200px", source = "assets/images/" + m.name + ".jpg"),
                  component = @GemRow(colGap = "20px", vAlign = "bottom", hAlign = "space-between",
                    components = [

                      @GemColumn(width = "40ch", rowGap = "10px", hAlign = "right", components = [
                        @GemText(value = m.name, size = "1.5rem"),
                        @GemText(value = m.machineStatus, size = "1.5rem", color = m.machineStatus == MachineStatus.RUNNING ? "green" : "red"),
                        @GemButton(width = "calc(10ch + 10px)", label = "More information", leftClick = showMachineCardPopup(m))
                      ])
                    ]
                  )
                );
              }
            ]
        ])
    ])
  ]);
}

