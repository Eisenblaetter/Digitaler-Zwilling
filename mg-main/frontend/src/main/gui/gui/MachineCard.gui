package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemDialog;

import Domain.Machine;
import Domain.MachineState;

component MachineCard(List<Machine> machines, ?boolean showDialog, ?long currentlySelectedMachine) {
    @GemColumn(rowGap = "20px", width = "90%", hAlign = "center", components = [
        @GemDialog(isOpen = showDialog, component =
            machineCardDialog@GemColumn(rowGap = "16px", width = "100%", components = [
                dialogHeader@GemRow(hAlign = "space-between", vAlign = "center", width = "100%", components = [
                    @GemText(value = getCurrentMachineDisplayName(), size = "1.4rem", weight = "bold"),
                    closeBtn@GemButton(label = "Close", leftClick = closeDialog())
                ]),
                @MachineCardPopup(m = getMachine())
            ])
        ),

        @GemText(value = "Monitoring — Machines Overview", size = "2rem", weight = "bold"),

        @GemGrid(
            x = ["1fr", "1fr", "1fr"],
            colGap = "30px",
            rowGap = "30px",
            rows = [
              [
                  @iterate(Machine m : machines) {
                    machineInfo@GemCard(titleComponent = @GemRow(colGap = "10px", vAlign = "center",
                      components = [
                        @GemIcon(name = "precision_manufacturing", size = "24px", color = getStatusTextColor(m.state)),
                        @GemText(value = m.displayName, size = "1.2rem", weight = "bold")
                      ]),
                      component = @GemColumn(rowGap = "15px", components = [
                        @GemImage(width = "100%", height = "150px", source = "assets/images/" + m.name + ".png"),
                        @GemRow(colGap = "10px", hAlign = "space-between", vAlign = "center",
                        components = [
                            @GemColumn(
                            components = [
                                @GemText(value = "Operational Status", size = "0.8rem", color = "grey"),
                                @GemText(value = m.state, size = "1rem", weight = "bold", color = getStatusTextColor(m.state))
                            ]),
                            @GemButton(label = "Details", leftClick = showMachineCardPopup(m))
                        ])
                      ])
                    );
                  }
              ]
            ]
        )
    ]);
}
