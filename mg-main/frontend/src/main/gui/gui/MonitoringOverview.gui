package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemDialog;

import Domain.Machine;

import gui.navigation.NavContainer;
import gui.machinecard.MachineCard;
import gui.machinecard.MachineRow;
import gui.machinecard.MachineCardPopup;

page MonitoringOverview(List<Machine> machines, ?boolean machineCardPopupVisible, ?long popupMachineId, ?boolean rowView) {
    @NavContainer(content = [
        pageHeader@GemText(value = "Machines Overview", size = "1.4rem", weight = "bold"),
        viewButton@GemButton(label = rowView ? "Grid View" : "List View", leftClick = toggleView()),
        @MachineCardPopup(
            showPopup = machineCardPopupVisible,
            machineGemId = popupMachineId,
            closeButtonClick = closeMachineCardPopup()
        ),
        @guard(rowView) {
            machineList@GemColumn(
                rowGap = "10px",
                components = [
                    @iterate(Machine m : machines) {
                        @MachineRow(
                            m = m,
                            detailsButtonClick = showMachineCardPopup(m)
                        );
                    }
                ]
            );
        } else {
            machineCardGrid@GemGrid(
                x = ["1fr", "1fr", "1fr"],
                colGap = "12px",
                rowGap = "12px",
                rows = [
                    [
                        @iterate(Machine m : machines) {
                            @MachineCard(
                                m = m,
                                detailsButtonClick = showMachineCardPopup(m)
                            );
                        }
                      ]
                ]
            );
        }
    ]);
}
