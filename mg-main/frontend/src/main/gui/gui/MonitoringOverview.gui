package gui;

import mc.fenix.basic.GemText;
import gui.navigation.NavContainer;
import gui.MachineCard;

page MonitoringOverview() {

  model MachinesModel {
    machines: Machine[];
  }

  onInit {
    loadMachinesCmd() -> MachinesModel.machines;
  }

  layout vertical {
    for m in MachinesModel.machines {
      component MachineCard(machine: m);
    }
  }
}
