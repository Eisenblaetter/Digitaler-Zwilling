package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemImage;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemIcon;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemGrid;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemDialog;

import Domain.Machine;

import gui.navigation.NavContainer;
import gui.machinecard.MachineCard;
import gui.machinecard.MachineCardPopup;

page MonitoringOverview(List<Machine> machines, ?boolean machineCardPopupVisible, ?long popupMachineId) {
    @NavContainer(content = [
        @GemText(value = "Monitoring — Machines Overview", size = "2rem", weight = "bold"),
        @MachineCardPopup(
            showPopup = machineCardPopupVisible,
            machineGemId = popupMachineId,
            closeButtonClick = closeMachineCardPopup()
        ),
        machineCardGrid@GemGrid(
            x = ["1fr", "1fr", "1fr"],
            colGap = "30px",
            rowGap = "30px",
            rows = [
                [
                    @iterate(Machine m : machines) {
                        @MachineCard(
                            m = m,
                            detailsButtonClick = showMachineCardPopup(m)
                        );
                    }
                ]
            ]
        )
    ]);
}
