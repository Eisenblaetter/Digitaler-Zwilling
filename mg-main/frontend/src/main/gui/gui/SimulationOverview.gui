package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import gui.navigation.NavContainer;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemDialog;
import mc.fenix.input.GemDropdownInput;
import mc.fenix.input.GemDropdownInputTypes.Option;

import gui.simulationcard.SimulationCard;
import gui.simulationcard.SimulationCardPopup;

import domain.Simulation;
import java.util.List;
import domain.SimulationService;
import gui.simulationcard.SimulationCardPopupContent;


page SimulationOverview(List<Simulation> simulations, ?boolean simulationCardPopupVisible, ?long popupSimulationId, ?String filterSelection, ?String sortSelection) {
    @NavContainer(content = [
        @SimulationCardPopup(
            selectedSimulationId = popupSimulationId,
            showDialog = simulationCardPopupVisible,
            closeButtonClick = closeSimulationCardPopup()
        ),
        @GemColumn(rowGap = "30px",components=[
            @GemText(value="Overview -- Simulations", size="3rem"),
            @GemRow(hAlign = "right", components=[
                @GemButton(label="New simulation", leftClick= openNewSimulationConfig())
            ]),
            @GemRow(colGap = "15px", components=[
                @GemDropdownInput(
                    entry = filterSelection,
                    labelText = "Filter",
                    width = "180px",
                    options = [
                        Option("all", "Alle"),
                        Option("running", "Running"),
                        Option("finished", "Finished"),
                        Option("failed", "Failed")
                    ]
                ),
                @GemDropdownInput(
                    entry = sortSelection,
                    labelText = "Sortieren",
                    width = "180px",
                    options = [
                        Option("status", "Status"),
                        Option("name", "Name")
                    ]
                )
            ]),
            @GemColumn(
                rowGap = "30px",
                components = [
                    @iterate(Simulation s : simulations) {
                        @SimulationCard(
                            s = s,
                            detailsButtonClick = showSimulationCardPopup(s)
                        );
                    }
                ]
            ),
            @GemCard(
                titleComponent = @GemRow(
                    colGap = "20px",
                    components = [
                        @GemText(
                            value = "Simulation A",
                            size = "2rem"
                        ),
                        @GemButton(label = "...")
                    ]
                ),
                component =
                    @GemRow(
                        width = "auto",
                        hAlign = "left",
                        colGap = "5px",
                        components = [
                            @GemText(
                                value = "🟡",
                                width = "15px"
                            ),
                            @GemText(
                                value = "running for 15m...",
                                width = "auto"
                            )
                        ]
                    )
            )
        ])
    ]);
}
