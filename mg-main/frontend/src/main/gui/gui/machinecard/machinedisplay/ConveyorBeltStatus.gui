package gui.machinecard.machinedisplay;

import mc.fenix.basic.GemText;
import mc.fenix.arrange.GemColumn;

component ConveyorBeltStatus(ConveyorBelt belt) {
    @GemColumn(components = [
        @GemText(value = "Direction: " + (belt.forward ? "Forward" : "Backward")),
        @GemText(value = "Conveyor Running: " + (belt.conveyorRunning ? "Yes" : "No"))
    ]);
}
