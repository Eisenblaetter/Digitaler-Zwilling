package gui.navigation;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemTreeNode;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemIcon;

import mc.fenix.navigation.GemNavItem;
import mc.fenix.navigation.GemNavList;

component NavContainer(List<GUIViewElement> content) {
  @GemRow(colGap = "0px", components = [
    // navigation bar
    @GemNavList(
      width = "300px", 
      height = "100vh", 
      header = @GemColumn(hAlign = "top", height="100px", components = [
          @GemIcon(name = "precision_manufacturing", size = "48px", color = "#1976d2"),
          @GemText(value = "Digital Twin", size = "1.5rem", weight = "bold", color = "#1976d2"),
          @GemRow(height = "2px", width = "80%", components = []) // simple divider
      ]),
      components = [
        @GemNavItem(title = "Home", target = "/gui/Start"),
        @GemNavItem(title = "Monitoring", target = "/gui/MonitoringOverview"),
        @GemTreeNode(
          isExpanded = true,
          content = @GemText(value = "Simulation", size = "1.1rem"),
          children = [
            @GemNavItem(title = "Overview", target = "/gui/SimulationOverview"),
            @GemNavItem(title = "Comparison", target = "/gui/SimulationComparison")
          ]
        ),
        @GemNavItem(title = "Scheduling", target = "/gui/SchedulingOverview")
      ]
    ),
    // main content
    primaryContent@GemColumn(width = "100%", components = content)
  ]);
}
