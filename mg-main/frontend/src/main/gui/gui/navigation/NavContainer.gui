package gui.navigation;

import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemTreeNode;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemIcon;

import mc.fenix.navigation.GemNavItem;
import mc.fenix.navigation.GemNavList;

import gui.navigation.IconButton;

component NavContainer(List<GUIViewElement> content) {
  @GemRow(colGap = "0px", components = [
    iconRail@GemColumn(
      width = "48px",
      height = "100vh",
      components = [
        railHeader@GemColumn(
          components = [
            @GemIcon(name = "precision_manufacturing", size = "24px", color = "white")
          ]
        ),
        railHome@IconButton(
          iconName = "home",
          routerLink = "/gui/Start"
        ),
        railMonitoring@IconButton(
          iconName = "monitor_heart",
          routerLink = "/gui/MonitoringOverview"
        ),
        railSimulation@IconButton(
          iconName = "science",
          routerLink = "/gui/SimulationOverview"
        ),
        railScheduling@IconButton(
          iconName = "schedule",
          routerLink = "/gui/SchedulingOverview"
        )
      ]
    ),

    secondaryNav@GemNavList(
      width = "200px",
      height = "100vh",
      header = secondaryNavHeader@GemRow(hAlign = "left", vAlign = "middle", components = [
        @GemText(value = "Digital Twin", size = "0.875rem", weight = "bold", color = "white")
      ]),
      components = [
        homeItem@GemNavItem(title = "Home", target = "/gui/Start"),
        monitoringItem@GemNavItem(title = "Monitoring", target = "/gui/MonitoringOverview"),
        simulationTree@GemTreeNode(
          isExpanded = true,
          content = @GemText(value = "Simulation", size = "1.1rem"),
          children = [
            @GemNavItem(title = "Overview", target = "/gui/SimulationOverview"),
            @GemNavItem(title = "Comparison", target = "/gui/SimulationComparison")
          ]
        ),
        schedulingItem@GemNavItem(title = "Scheduling", target = "/gui/SchedulingOverview")
      ]
    ),

    mainArea@GemColumn(
      width = "100%",
      components = [
        topHeader@GemRow(
          width = "100%",
          height = "48px",
          hAlign = "right",
          vAlign = "middle",
          components = [
            @IconButton(
                iconName = "help"
            ),
            @IconButton(
                iconName = "settings"
            )
          ]
        ),
        primaryContent@GemColumn(width = "100%", components = content)
      ]
    )
  ]);
}
