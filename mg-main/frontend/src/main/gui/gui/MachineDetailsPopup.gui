package gui;

import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.basic.GemImage;
import mc.fenix.arrange.GemCard;

//page MachineDetailsPopup(
component MachineDetailsPopup(
    String name,
    String status,
    Integer temperature,
    Integer rpm,
    Integer load,
    String lastMaintenance,
){
  @GemCard(
    title = "Machine Details",
    titleComponent = @GemText(value = name, size = "1.4rem", weight = "bold"),
    component = @GemRow(colGap = "30px", components = [

      //links Bild
      @GemImage(
        source = "assets/images/" + m.name + ".png"
        width = "320px",
        height = "240px",
      ),

      //rechts details
      @GemColumn(rowGap = "15px", components = [

        @GemRow(colGap = "10px", components = [
          @GemText(value = "Status: "),
          @GemText(value = status)
        ]),

        @GemRow(colGap = "10px", components = [
          @GemText(value = "Temperature: "),
          @GemText(value = temperature.toString() + " °C")
        ]),

        @GemRow(colGap = "10px", components = [
          @GemText(value = "RPM: "),
          @GemText(value = rpm.toString())
        ]),

        @GemRow(colGap = "10px", components = [
          @GemLoadingSpinner(
             size = "10px",
             intermediate = true,
             label = "Loading ..."
          @GemText(value = load.toString() + " %")
        ]),

        @GemRow(colGap = "10px", components = [
          @GemText(value = "Last maintenance: "),
          @GemText(value = lastMaintenance)
        ]),

        @GemButton(
          label = "Close",
          leftClick = closePopup()
        )
      ])
    ])
  );
}
