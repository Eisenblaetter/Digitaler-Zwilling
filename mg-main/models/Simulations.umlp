umlp Simulations {

  enum SimulationState {
    RUNNING,
    FINISHED,
    FAILED;
  }

  interface SimMachineState {}

  class Simulation {
    int simulationId;
    String name;
    SimulationState state;
    int duration;
    int totalConsumption;
    int avgConsumption;
    int countMachines;
  }

  class SimConfig {
    int speedModifier;
    String processName;
    double temperatureOverride;
    // more complex attributes in manual extensions, e.g. transitionOverrides
  }

  class SimMachine {
    SimConfig config;
    SimMachineState state;
  }

  class SimStateTransition {
    int order;
    SimMachineState toState;
    int baseExecutionTimeMs;
  }
}
