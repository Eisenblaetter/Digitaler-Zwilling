umlp Simulations {

  enum SimulationState {
    RUNNING,
    FINISHED,
    FAILED;
  }

  class Simulation {
    int simulationId;
    String name;
    SimulationState state;

    int duration;
    int totalConsumption;
    int avgConsumption;
    int countMachines;
  }

  class SimConfig {
    double speedModifier;
    String processName;
    double temperatureOverride;
    // more complex attributes in manual extensions, e.g. transitionOverrides
  }

  class SimMachine {
    SimConfig config;
    // name of the current engine state (enum), shown live in the frontend
    String currentState;
  }
}
