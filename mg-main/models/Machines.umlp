umlp Machines {
    enum MachineState {
        UNINITIALIZED_IDLE,
        INITIALIZED_IDLE,
        UNINITIALIZED_ACTIVE,
        INITIALIZED_ACTIVE,
        RUNNING,
        STOPPED,
        ERROR;
    }

    class Machine {
        String name;
        String displayName;
        String mqttTopic;
        MachineState state;

        // Monitoring
        Double temperature;
        Double load;
        Double throughput;
        Double energyConsumption;

        // Maintenance
        String maintenanceDue;

        // Logs
        List<String> errors;

        // Allgemein gültig
        String imageName;
        String lastUpdate;
    }

    // add specific properties for each machine
    class ConveyorBelt extends Machine {}
    class HighBay extends Machine {}
    class MultiProcessing extends Machine {}
    class SortingLine extends Machine {}
    class VacuumGripper extends Machine {}
}
