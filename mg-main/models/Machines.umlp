import java.time.LocalDateTime;

umlp Machines {
    enum MachineState {
        UNINITIALIZED_IDLE,
        INITIALIZED_IDLE,
        UNINITIALIZED_ACTIVE,
        INITIALIZED_ACTIVE,
        RUNNING,
        STOPPED,
        ERROR;
    }

    class Machine {
        String name;
        String displayName;
        String mqttTopic;
        MachineState state;
        boolean selected;

        // Monitoring
        Double temperature;
        Integer rpm; //Rotation per Minute
        Double load;
        Double throughput;
        Double energyConsumption;

        // Maintenance
        String lastMaintenance;
        String maintenanceDue;

        // Logs
        List<String> errors;

        // Allgemein gültig
        String lastUpdate;
    }

    // add specific properties for each machine
    class ConveyorBelt extends Machine {
            //public LocalDateTime timestamp;
            boolean forward;
            boolean conveyorRunning;
        }
    class HighBay extends Machine {
        //public LocalDateTime timestamp;
        boolean dirty;
        String ejectedToBranch;
        boolean actDown;
        boolean actUp;
        boolean actCantileverForward;
        boolean actCantileverBackward;
    }
    class MultiProcessing extends Machine {
        //LocalDateTime timestamp;
        String colorPresent;
        boolean conveyorRunning;
        boolean dirty;
        String ejectedToBranch;
        boolean actOvenInward;
        boolean sensOven;
        boolean ovenLight;
        boolean actGripperToOven;
        boolean sensTurntablePosVacuum;
        boolean actRotClockwise;
        boolean sensTurntablePosSaw;
        boolean actSaw;
        boolean conveyorForward;
        boolean compressor;
    }
    class SortingLine extends Machine {
        //public String machineName
        //public LocalDateTime timestamp;
        String colorPresent;
        boolean conveyorRunning;
        boolean compressorRunning; //publics weg
        boolean actRedEjector;
        boolean dirty;
        String ejectedToBranch;
    }
    class VacuumGripper extends Machine {

           boolean dirty;
           String ejectedToBranch;
           boolean actVerticalUp;
           boolean actVerticalDown;
           boolean actRotRight;
           boolean actRotLeft;
           boolean actArmOut;
           boolean actArmIn;
           boolean compressorOn;
           boolean valve;
    }

}
