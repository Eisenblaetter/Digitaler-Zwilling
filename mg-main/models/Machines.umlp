import java.time.LocalDateTime;

umlp Machines {
    enum MachineState {
        UNINITIALIZED_IDLE,
        INITIALIZED_IDLE,
        UNINITIALIZED_ACTIVE,
        INITIALIZED_ACTIVE,
        RUNNING,
        STOPPED,
        ERROR;
    }

    class Machine {
        String name;
        String displayName;
        String mqttTopic;
        MachineState state;

        // Monitoring
        Double temperature;
        Integer rpm; //Rotation per Minute
        Double load;
        Double throughput;
        Double energyConsumption;

        // Maintenance
        String lastMaintenance;
        String maintenanceDue;

        // Logs
        List<String> errors;

        // Allgemein gültig
        String lastUpdate;
    }

    // add specific properties for each machine
    class ConveyorBelt extends Machine {
            //public LocalDateTime timestamp;
            public boolean forward;
            public boolean conveyorRunning;
        }
    class HighBay extends Machine {
        //public LocalDateTime timestamp;
        public boolean dirty;
        public String ejectedToBranch;
        public boolean actDown;
        public boolean actUp;
        public boolean actCantileverForward;
        public boolean actCantileverBackward;
    }
    class MultiProcessing extends Machine {
        //LocalDateTime timestamp;
        public String colorPresent;
        public boolean conveyorRunning;
        public boolean dirty;
        public String ejectedToBranch;
        public boolean actOvenInward;
        public boolean sensOven;
        public boolean ovenLight;
        public boolean actGripperToOven;
        public boolean sensTurntablePosVacuum;
        public boolean actRotClockwise;
        public boolean sensTurntablePosSaw;
        public boolean actSaw;
        public boolean conveyorForward;
        public boolean compressor;
    }
    class SortingLine extends Machine {
        //public String machineName
        //public LocalDateTime timestamp;
        public String colorPresent;
        public boolean conveyorRunning;
        public boolean compressorRunning;
        public boolean actRedEjector;
        public boolean dirty;
        public String ejectedToBranch;
    }
    class VacuumGripper extends Machine {}
}
